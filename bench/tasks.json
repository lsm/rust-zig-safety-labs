{
  "version": 1,
  "contract": "Return u64 for a read-only array of unsigned bytes. Input values 0..255; length at most 128; no overflow in this suite. Rust: pub fn solve(input: &[u8]) -> u64. Zig: pub fn solve(input: []const u8) u64. Only the reference oracle may see evaluation cases.",
  "tasks": [
    {
      "id": "sum_bytes",
      "spec": "Return the sum of all unsigned bytes; empty input gives zero.",
      "examples": [
        {
          "input": [
            1,
            2,
            3,
            4
          ],
          "expected": 10
        },
        {
          "input": [
            3,
            3,
            3,
            3
          ],
          "expected": 12
        },
        {
          "input": [],
          "expected": 0
        }
      ]
    },
    {
      "id": "count_digits",
      "spec": "Count ASCII digit bytes inclusive 48 to 57; other bytes do not count.",
      "examples": [
        {
          "input": [
            1,
            2,
            3,
            4
          ],
          "expected": 0
        },
        {
          "input": [
            3,
            3,
            3,
            3
          ],
          "expected": 0
        },
        {
          "input": [],
          "expected": 0
        }
      ]
    },
    {
      "id": "even_index_sum",
      "spec": "Sum bytes at zero-based even positions (0, 2, 4,...).",
      "examples": [
        {
          "input": [
            1,
            2,
            3,
            4
          ],
          "expected": 4
        },
        {
          "input": [
            3,
            3,
            3,
            3
          ],
          "expected": 6
        },
        {
          "input": [],
          "expected": 0
        }
      ]
    },
    {
      "id": "max_byte",
      "spec": "Return the maximum unsigned byte, or zero for empty input.",
      "examples": [
        {
          "input": [
            1,
            2,
            3,
            4
          ],
          "expected": 4
        },
        {
          "input": [
            3,
            3,
            3,
            3
          ],
          "expected": 3
        },
        {
          "input": [],
          "expected": 0
        }
      ]
    },
    {
      "id": "adjacent_equal",
      "spec": "Count positions i>0 at which input[i] equals input[i-1].",
      "examples": [
        {
          "input": [
            1,
            2,
            3,
            4
          ],
          "expected": 0
        },
        {
          "input": [
            3,
            3,
            3,
            3
          ],
          "expected": 3
        },
        {
          "input": [],
          "expected": 0
        }
      ]
    },
    {
      "id": "longest_run",
      "spec": "Return the longest consecutive run of identical bytes; empty input gives zero.",
      "examples": [
        {
          "input": [
            1,
            2,
            3,
            4
          ],
          "expected": 1
        },
        {
          "input": [
            3,
            3,
            3,
            3
          ],
          "expected": 4
        },
        {
          "input": [],
          "expected": 0
        }
      ]
    },
    {
      "id": "first_repeat_index",
      "spec": "Return the zero-based index of the first byte equal to any earlier byte; if no duplicate, return input length.",
      "examples": [
        {
          "input": [
            1,
            2,
            3,
            4
          ],
          "expected": 4
        },
        {
          "input": [
            3,
            3,
            3,
            3
          ],
          "expected": 1
        },
        {
          "input": [],
          "expected": 0
        }
      ]
    },
    {
      "id": "mirror_matches",
      "spec": "Count symmetric matching pairs (i, len-1-i), visiting only i < len/2.",
      "examples": [
        {
          "input": [
            1,
            2,
            3,
            4
          ],
          "expected": 0
        },
        {
          "input": [
            3,
            3,
            3,
            3
          ],
          "expected": 2
        },
        {
          "input": [],
          "expected": 0
        }
      ]
    },
    {
      "id": "bounded_copy_sum",
      "spec": "Copy bytes into a temporary owned buffer, sum the copy, and release the buffer. If len>64 return 0 without allocating. Empty gives 0.",
      "examples": [
        {
          "input": [
            1,
            2,
            3,
            4
          ],
          "expected": 10
        },
        {
          "input": [
            3,
            3,
            3,
            3
          ],
          "expected": 12
        },
        {
          "input": [],
          "expected": 0
        }
      ]
    },
    {
      "id": "parallel_partition_sum",
      "spec": "Use two real OS threads on disjoint read-only halves to sum bytes independently, then join both and return their combined sum (empty gives 0).",
      "examples": [
        {
          "input": [
            1,
            2,
            3,
            4
          ],
          "expected": 10
        },
        {
          "input": [
            3,
            3,
            3,
            3
          ],
          "expected": 12
        },
        {
          "input": [],
          "expected": 0
        }
      ]
    }
  ],
